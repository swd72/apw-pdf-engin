{
  "name": "@apw-pdf/react",
  "version": "0.1.0",
  "description": "React components (<PdfPreview>, <PdfDownloadButton>), usePdf hook, and Web Worker renderer for @apw-pdf.",
  "keywords": [
    "pdf",
    "thai",
    "react",
    "preview",
    "web-worker",
    "pdfjs"
  ],
  "license": "MIT",
  "homepage": "https://github.com/swd72/apw-pdf-engin#readme",
  "bugs": {
    "url": "https://github.com/swd72/apw-pdf-engin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swd72/apw-pdf-engin.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@apw-pdf/core": "workspace:*",
    "@apw-pdf/fonts": "workspace:*",
    "@apw-pdf/pdf": "workspace:*",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@apw-pdf/templates": "workspace:*",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "harfbuzzjs": "1.6.4",
    "jsdom": "^26.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
