    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "harfbuzzjs": "1.6.4",
    "jsdom": "^26.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
