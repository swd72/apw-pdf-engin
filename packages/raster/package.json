{
  "name": "@apw-pdf/raster",
  "version": "0.1.0",
  "description": "PDF-to-PNG page rasterizer for @apw-pdf built on pdfjs-dist and @napi-rs/canvas.",
  "keywords": [
    "pdf",
    "thai",
    "raster",
    "png",
    "canvas",
    "pdfjs"
  ],
  "license": "MIT",
  "homepage": "https://github.com/swd72/apw-pdf-engin#readme",
  "bugs": {
    "url": "https://github.com/swd72/apw-pdf-engin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swd72/apw-pdf-engin.git",
    "directory": "packages/raster"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.68",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@apw-pdf/core": "workspace:*",
    "@apw-pdf/fonts": "workspace:*",
    "@apw-pdf/pdf": "workspace:*",
    "@types/node": "^22.13.10",
    "harfbuzzjs": "1.6.4",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
