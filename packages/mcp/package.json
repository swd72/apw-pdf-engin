{
  "name": "@apw-pdf/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for generating and previewing Thai government PDF documents with @apw-pdf.",
  "keywords": [
    "pdf",
    "thai",
    "mcp",
    "model-context-protocol",
    "claude",
    "ai"
  ],
  "license": "MIT",
  "homepage": "https://github.com/swd72/apw-pdf-engin#readme",
  "bugs": {
    "url": "https://github.com/swd72/apw-pdf-engin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swd72/apw-pdf-engin.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "apw-pdf-mcp": "./bin/apw-pdf-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@apw-pdf/core": "workspace:*",
    "@apw-pdf/node": "workspace:*",
    "@apw-pdf/raster": "workspace:*",
    "@apw-pdf/templates": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
