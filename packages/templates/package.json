{
  "name": "@apw-pdf/templates",
  "version": "0.1.0",
  "description": "Thai government document templates (memo, external letter, leave form) and Garuda assets for @apw-pdf.",
  "keywords": [
    "pdf",
    "thai",
    "templates",
    "government",
    "memo",
    "saraban"
  ],
  "license": "MIT",
  "homepage": "https://github.com/swd72/apw-pdf-engin#readme",
  "bugs": {
    "url": "https://github.com/swd72/apw-pdf-engin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swd72/apw-pdf-engin.git",
    "directory": "packages/templates"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@apw-pdf/core": "workspace:*"
  },
  "devDependencies": {
    "@apw-pdf/fonts": "workspace:*",
    "@apw-pdf/pdf": "workspace:*",
    "@apw-pdf/raster": "workspace:*",
    "@types/node": "^22.13.10",
    "harfbuzzjs": "1.6.4",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
