{
  "name": "@apw-pdf/templates",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@apw-pdf/core": "workspace:*"
  },
  "devDependencies": {
    "@apw-pdf/fonts": "workspace:*",
    "@apw-pdf/pdf": "workspace:*",
    "@types/node": "^22.13.10",
    "harfbuzzjs": "1.6.4",
    "pngjs": "^7.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
