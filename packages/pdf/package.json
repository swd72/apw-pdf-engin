{
  "name": "@apw-pdf/pdf",
  "version": "0.1.0",
  "description": "PDF 1.7 writer for @apw-pdf with CIDFontType2 TrueType subsetting, ToUnicode CMap, and Thai Sara Am handling.",
  "keywords": [
    "pdf",
    "thai",
    "pdf-lib",
    "harfbuzz",
    "subset",
    "cidfont"
  ],
  "license": "MIT",
  "homepage": "https://github.com/swd72/apw-pdf-engin#readme",
  "bugs": {
    "url": "https://github.com/swd72/apw-pdf-engin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swd72/apw-pdf-engin.git",
    "directory": "packages/pdf"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@apw-pdf/core": "workspace:*",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@apw-pdf/fonts": "workspace:*",
    "harfbuzzjs": "1.6.4",
    "pdfjs-dist": "^5.4.0"
  }
}
