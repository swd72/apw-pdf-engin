{
  "name": "@apw-pdf/fonts",
  "version": "0.1.0",
  "description": "SIPA Thai font files (TH Sarabun New and TH Sarabun PSK) and font family helpers for @apw-pdf.",
  "keywords": [
    "pdf",
    "thai",
    "fonts",
    "sipa",
    "sarabun",
    "truetype"
  ],
  "license": "MIT",
  "homepage": "https://github.com/swd72/apw-pdf-engin#readme",
  "bugs": {
    "url": "https://github.com/swd72/apw-pdf-engin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swd72/apw-pdf-engin.git",
    "directory": "packages/fonts"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./files/*": "./files/*"
  },
  "files": [
    "dist",
    "files",
    "LICENSE",
    "LICENSE-SIPA.txt",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@apw-pdf/core": "workspace:*"
  }
}
